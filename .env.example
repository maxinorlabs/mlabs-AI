# Google Apps Script web app that receives contact form submissions.
# Set per environment on Cloud Run from Secret Manager (prod and staging use different scripts).
CONTACT_FORM_APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Staging only: when both are set, every page asks for this username and password.
# Leave unset in production and local development.
STAGING_BASIC_AUTH_USER=""
STAGING_BASIC_AUTH_PASSWORD=""

# Optional: public site URL used for canonical URLs, sitemap and structured data.
# Defaults to https://mlabs.co.in.
NEXT_PUBLIC_SITE_URL=""
